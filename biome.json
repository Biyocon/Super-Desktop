{
	"$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
	"files": {
		"includes": [
			"apps/desktop/src/features/app/**/*.ts",
			"apps/desktop/src/features/app/**/*.tsx",
			"apps/desktop/src/features/chat/composer/**/*.ts",
			"apps/desktop/src/features/chat/composer/**/*.tsx",

			"apps/desktop/src/features/conductor/**/*.ts",

			"apps/desktop/src/features/conductor/**/*.tsx",
			"apps/desktop/src/features/plugins/**/*.ts",
			"apps/desktop/src/features/plugins/**/*.tsx",
			"apps/desktop/src/features/settings/**/*.ts",
			"apps/desktop/src/features/settings/**/*.tsx",
			"apps/desktop/electron/main/runtime/session-launch.ts",
			"apps/desktop/electron/main/ipc/workspace-ipc.ts",
			"apps/desktop/electron/main/conductor/**/*.ts",
			"apps/desktop/electron/main/ipc/conductor-ipc.ts",
			"packages/shared/src/types/**/*.ts",
			"scripts/check-architecture.mjs",
			"packages/agent-runtime/src/conductor/**/*.ts",
			"packages/agent-runtime/src/file-tool-parameters.ts",
			"packages/agent-runtime/src/sidecar.ts",
			"packages/agent-runtime/bundle-conductor.mjs",
			"packages/host-runtime/src/conductor*.ts",
			"packages/host-runtime/src/agent-sidecar.ts",
			"packages/conductor-runtime/src/**/*.mjs",
			"packages/conductor-runtime/test/**/*.mjs",
			"packages/conductor-runtime/types/**/*.ts",
			"packages/conductor-runtime/types/**/*.mts",
			"packages/conductor-runtime/build.mjs",
			"packages/conductor-runtime/build-types.mjs",
			"packages/conductor-runtime/typecheck.mjs",

			"scripts/e2e/*.mjs"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"correctness": {
				"noUnusedVariables": "error"
			}
		}
	}
}
